OPERIS_POSTGRES_DB=operis
OPERIS_POSTGRES_USER=operis
OPERIS_POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Prisma PostgreSQL URL: parola içinde @ : / ? # % gibi karakterler varsa percent-encode edilmelidir.
# Local candidate Compose içindeki host adı "postgres" olmalıdır.
OPERIS_POSTGRES_DATABASE_URL=postgresql://operis:URL_ENCODED_PASSWORD@postgres:5432/operis?schema=public&connection_limit=20&connect_timeout=5&pool_timeout=10&application_name=operis

OPERIS_PORT=3001
JWT_SECRET=CHANGE_ME_64_HEX_OR_LONG_RANDOM
DATA_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64
CLIENT_ORIGIN=http://127.0.0.1:3001
PUBLIC_URL=http://127.0.0.1:3001
COOKIE_SECURE=false
