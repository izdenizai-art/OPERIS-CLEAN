FROM node:22-alpine AS client-build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM node:22-alpine AS server-build
WORKDIR /app/server
COPY server/package*.json ./
RUN npm install
COPY server .
RUN npx prisma generate --schema prisma/schema.postgresql.prisma && npm run build

FROM node:22-alpine
WORKDIR /app/server
ENV NODE_ENV=production
COPY --from=server-build /app/server/package*.json ./
RUN npm install --omit=dev
COPY --from=server-build /app/server/dist ./dist
COPY --from=server-build /app/server/prisma ./prisma
COPY --from=client-build /app/server/public ./public
EXPOSE 3001

CMD ["sh", "-c", "test -n \"$DATABASE_URL\" && case \"$DATABASE_URL\" in postgres://*|postgresql://*) ;; *) echo 'DATABASE_URL PostgreSQL değil; container durduruldu.' >&2; exit 64;; esac; npx prisma db push --schema prisma/schema.postgresql.prisma && node dist/index.js"]
